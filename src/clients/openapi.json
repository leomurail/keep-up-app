    "components": {
        "schemas": {
            "AirdropEvent": {
                "required": [
                    "id",
                    "title"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "title": {
                        "type": "string"
                    },
                    "category": {
                        "nullable": true,
                        "oneOf": [
