                        "type": "string"
                    },
                    "width": {
                        "type": "integer"
                    },
                    "height": {
                        "type": "integer"
                    },
                    "alt": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "Status": {
                "required": [
                    "id",
                    "slug",
                    "label",
                    "airdropEvents"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "label": {
                        "type": "string"
                    },
                    "airdropEvents": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/AirdropEvent"
                        }
                    }
                },
                "type": "object"
            },
            "User": {
                "required": [
                    "id",
                    "email",
                    "userIdentifier",
                    "password"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "email": {
                        "type": "string"
                    },
                    "userIdentifier": {
                        "title": "A visual identifier that represents this user.",
                        "type": "string"
                    },
                    "roles": {
                        "title": "The user roles",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": []
                    },
                    "password": {
                        "title": "The hashed password",
                        "type": "string"
                    },
                    "token": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "SocialMedia": {
                "required": [
                    "id",
                    "slug",
                    "label",
                    "airdropEvent"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "label": {
                        "type": "string"
                    },
                    "image": {
